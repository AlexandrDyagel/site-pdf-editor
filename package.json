{
  "name": "pdf-editor-web",
  "private": true,
  "version": "1.0.0",
  "description": "Клиентский веб-редактор PDF: аннотации, штампы, печати, подписи. Вся обработка — локально в браузере.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "build:only": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview --port 4173",
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "verify": "esbuild scripts/verify-logic.ts --bundle --platform=node --format=esm --target=node20 --alias:@=./src --outfile=.tmp/verify-logic.mjs --log-level=warning && node .tmp/verify-logic.mjs",
    "check:components": "node scripts/check-component-imports.mjs",
    "check:pdf": "node scripts/make-test-pdf.mjs",
    "check:browser": "node scripts/make-test-pdf.mjs && node scripts/browser-check.mjs",
    "check:workflow": "node scripts/make-test-pdf.mjs && node scripts/browser-workflow.mjs",
    "check:interaction": "node scripts/make-test-pdf.mjs && node scripts/browser-interaction.mjs",
    "check:corrector": "node scripts/make-test-pdf.mjs && node scripts/check-corrector.mjs",
    "check:rotation": "node scripts/make-test-pdf.mjs && node scripts/check-rotation.mjs",
    "check:user-font": "node scripts/make-test-pdf.mjs && node scripts/check-user-font.mjs",
    "check:font-ui": "node scripts/make-test-pdf.mjs && node scripts/check-font-ui.mjs",
    "check:layout": "node scripts/make-test-pdf.mjs && node scripts/check-layout.mjs",
    "check:tooltips": "node scripts/make-test-pdf.mjs && node scripts/check-tooltips.mjs",
    "check:hotkeys": "node scripts/make-test-pdf.mjs && node scripts/check-hotkeys.mjs",
    "check:canvas-tools": "node scripts/make-test-pdf.mjs && node scripts/check-canvas-tools.mjs",
    "check:layer-order": "node scripts/make-test-pdf.mjs && node scripts/check-layer-order.mjs",
    "check:shape-styles": "node scripts/make-test-pdf.mjs && node scripts/check-shape-styles.mjs",
    "check:shapes-extra": "node scripts/make-test-pdf.mjs && node scripts/check-shapes-extra.mjs",
    "check:history": "node scripts/make-test-pdf.mjs && node scripts/check-history.mjs",
    "check:drop-toast": "node scripts/make-test-pdf.mjs && node scripts/check-drop-toast.mjs",
    "check:export-pages": "node scripts/make-test-pdf.mjs && node scripts/check-export-pages.mjs",
    "check:text-inline": "node scripts/make-test-pdf.mjs && node scripts/check-text-inline.mjs",
    "check:transform": "node scripts/make-test-pdf.mjs && node scripts/check-transform-any-tool.mjs",
    "check:groups": "node scripts/make-test-pdf.mjs && node scripts/check-groups.mjs",
    "check:fonts": "node scripts/check-font-subsets.mjs",
    "check:font-embed": "node scripts/check-font-embed.mjs",
    "check:bundled-fonts": "node scripts/make-test-pdf.mjs && node scripts/check-bundled-fonts.mjs",
    "check:projects": "node scripts/make-test-pdf.mjs && node scripts/check-projects.mjs",
    "check:all": "pnpm typecheck && pnpm verify && pnpm check:components && pnpm check:workflow && pnpm check:interaction && pnpm check:corrector && pnpm check:rotation && pnpm check:user-font && pnpm check:font-ui && pnpm check:layout && pnpm check:tooltips && pnpm check:hotkeys && pnpm check:canvas-tools && pnpm check:layer-order && pnpm check:shape-styles && pnpm check:shapes-extra && pnpm check:history && pnpm check:drop-toast && pnpm check:export-pages && pnpm check:text-inline && pnpm check:transform && pnpm check:groups && pnpm check:font-embed && pnpm check:bundled-fonts && pnpm check:projects"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.5.1",
    "file-saver": "^2.0.5",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "konva": "^9.3.20",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "perfect-freehand": "^1.2.2",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.12",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
